{{/*
  DO NOT EDIT THIS FILE

  This is a Helm "helpers" file. It defines small reusable snippets (the
  resource names and labels) that deployment.yaml and service.yaml pull in, so
  those files don't repeat the same text. The actual values you edit live in
  values.yaml and terraform/terraform.tfvars, not here.

  Note: the blocks wrapped in slash-star markers (like this one) are comments
  and are ignored when the chart is rendered.
*/}}

{{/*
app.name: the base name for the app. Defaults to the chart name ("challenge")
unless you set nameOverride in values.yaml.
*/}}
{{- define "app.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
app.fullname: the full resource name, formed as "<release name>-<app name>".
The release name comes from release_name in terraform/terraform.tfvars. For
example, release_name = "hello" gives the name "hello-challenge".
*/}}
{{- define "app.fullname" -}}
{{- printf "%s-%s" .Release.Name (include "app.name" .) | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
app.labels: a standard set of labels attached to every resource. Labels are
just tags Kubernetes uses to identify and group resources.
*/}}
{{- define "app.labels" -}}
app.kubernetes.io/name: {{ include "app.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version }}
{{- end -}}

{{/*
app.selectorLabels: the subset of labels used to connect things together. The
Service uses them to find its pods, and the Deployment uses them to track the
pods it owns. These must stay consistent, which is why they live in one place.
*/}}
{{- define "app.selectorLabels" -}}
app.kubernetes.io/name: {{ include "app.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}
